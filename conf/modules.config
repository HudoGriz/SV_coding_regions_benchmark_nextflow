/*
========================================================================================
    Module configuration
========================================================================================
    This file configures process-specific settings and container overrides.
    Container overrides are necessary because some nf-core modules have incorrect
    container paths (e.g., biocontainers/tool instead of quay.io/biocontainers/tool)
========================================================================================
*/

process {
    // Fix container paths and add process-specific configuration
    // withName: 'SAMTOOLS_.*' {
    //     container = 'quay.io/biocontainers/samtools:1.19.2--h50ea8bc_1'
    // }
    
    withName: 'MANTA_WES' {
        // container = 'quay.io/biocontainers/manta:1.6.0--h9ee0642_1'
        ext.args = '--exome'  // Turn off depth filters for WES data
        publishDir = [
            path: { "${params.outdir}/sv_calls/Illumina_WES/Manta" },
            mode: 'copy',
            saveAs: { filename -> 
                if (filename.endsWith('.vcf.gz') || filename.endsWith('.vcf.gz.tbi')) {
                    filename
                } else if (filename.equals('versions.yml')) {
                    null
                } else {
                    filename
                }
            }
        ]
    }
    
    withName: 'MANTA_WGS' {
        // container = 'quay.io/biocontainers/manta:1.6.0--h9ee0642_1'
        publishDir = [
            path: { "${params.outdir}/sv_calls/Illumina_WGS/Manta" },
            mode: 'copy',
            saveAs: { filename -> 
                if (filename.endsWith('.vcf.gz') || filename.endsWith('.vcf.gz.tbi')) {
                    filename
                } else if (filename.equals('versions.yml')) {
                    null
                } else {
                    filename
                }
            }
        ]
    }
    
    withName: 'DELLY_CALL' {
        // Delly threads across samples, so a single BAM runs on one core
        // (chr21 of the 60x GRCh37 BAM: 40 s at 99% CPU with --threads 8).
        cpus = 2
        memory = '16.GB'
        time = '24.h'
        ext.prefix = { "${meta.technology}-${meta.tool}" }
        publishDir = [
            path: { "${params.outdir}/sv_calls/Illumina_WGS/Delly" },
            mode: 'copy',
            pattern: '*.vcf.gz*'
        ]
    }
    withName: 'DELLY_CALL_WES' {
        cpus = 2
        memory = '16.GB'
        time = '24.h'
        ext.prefix = { "${meta.technology}-${meta.tool}" }
        publishDir = [
            path: { "${params.outdir}/sv_calls/Illumina_WES/Delly" },
            mode: 'copy',
            pattern: '*.vcf.gz*'
        ]
    }
    withName: 'DELLY_TARGET_EXCLUDE' {
        container = { params.analysis_container }
        publishDir = [
            path: { "${params.outdir}/sv_calls/Illumina_WES/Delly" },
            mode: 'copy'
        ]
    }

    // withName: 'PBSV_.*' {
    //     container = 'quay.io/biocontainers/pbsv:2.9.0--h9ee0642_0'
    // }
    
    withName: 'PBSV_DISCOVER' {
        memory = '64.GB'
        publishDir = [
            path: { "${params.outdir}/sv_calls/PacBio/PBSV" },
            mode: 'copy',
            pattern: '*.svsig.gz',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    
    withName: 'PBSV_CALL' {
        publishDir = [
            path: { "${params.outdir}/sv_calls/PacBio/PBSV" },
            mode: 'copy',
            pattern: '*.vcf',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    
    withName: 'SNIFFLES' {
        // container = 'quay.io/biocontainers/sniffles:2.2--pyhdfd78af_0'
        publishDir = [
            path: { "${params.outdir}/sv_calls/ONT/Sniffles" },
            mode: 'copy',
            pattern: '*.vcf.gz*',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    
    withName: 'CUTESV_PACBIO' {
        // container = 'quay.io/biocontainers/cutesv:2.0.3--pyhdfd78af_0'
        publishDir = [
            path: { "${params.outdir}/sv_calls/PacBio/CuteSV" },
            mode: 'copy',
            pattern: '*.vcf',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    
    withName: 'CUTESV_ONT' {
        // container = 'quay.io/biocontainers/cutesv:2.0.3--pyhdfd78af_0'
        publishDir = [
            path: { "${params.outdir}/sv_calls/ONT/CuteSV" },
            mode: 'copy',
            pattern: '*.vcf',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    
    withName: 'TRUVARI_BENCH' {
        // Truvari 5.4.0 plus --bench-overlaps.
        // Source: CISLD/truvari, branch deploy/bench-overlaps-5.4.0, built
        // from Singularity.bench-overlaps. Override with --truvari_container.
        // A closure, because this file is included before the params block is
        // evaluated; a direct reference would resolve to null.
        container = { params.truvari_container }

        // --bench-overlaps 1  score calls sharing at least one position with
        //                   the target rather than requiring containment, so
        //                   an SV spanning an exon boundary is not discarded
        //                   as a filtering artifact. The value is a minimum
        //                   shared length; 0 would restore containment. This
        //                   is the one behaviour upstream does not offer.
        // --bnddist -1      upstream's documented switch for excluding
        //                   breakends (docs/bench.md, "BND Comparison"). It
        //                   routes BNDs into the filtered bucket, so they are
        //                   dropped from both call sets rather than counted as
        //                   false positives. Needed because the GIAB truth
        //                   sets hold only DEL and INS: Manta emits 39.8% of
        //                   its PASS calls as BND against 0.2-2.2% for the
        //                   long-read callers, so retaining them would measure
        //                   breakend reporting, not SV detection. Truvari 5.0
        //                   dropped BNDs implicitly; 5.1 added BND comparison,
        //                   so the choice has to be stated explicitly now.
        //
        // meta.bench_overlaps lets the sensitivity benchmarks score full
        // containment (0). Everything else leaves it unset and gets 1, so the
        // command line of the primary benchmarks is unchanged.
        ext.args = {
            def bnd = (meta.bnd_mode ?: params.primary_bnd_mode) == 'nobnd' ? '--bnddist -1 ' : ''
            def overlaps = meta.bench_overlaps != null ? meta.bench_overlaps : 1
            "--bench-overlaps ${overlaps} ${bnd}--passonly --dup-to-ins ${meta.truvari_args ?: ''}"
        }
        ext.prefix = { "${meta.technology}-${meta.tool}-${meta.target}" }
        publishDir = [
            path: {
                // The primary breakend mode keeps the original layout so the
                // downstream R statistics are unaffected; any other mode is
                // published alongside it under bnd_sensitivity/.
                def mode = meta.bnd_mode ?: params.primary_bnd_mode
                def root = mode == params.primary_bnd_mode
                    ? "${params.outdir}"
                    : "${params.outdir}/bnd_sensitivity/${mode}"
                if (meta.target_set == 'simulated') {
                    "${root}/simulations/benchmarks/${meta.technology}/${meta.tool}"
                } else if (meta.target_set == 'sensitivity') {
                    "${root}/sensitivity/${meta.setting}/${meta.technology}/${meta.tool}/${meta.target}"
                } else {
                    "${root}/real_intervals/${meta.technology}/truvari/${meta.tool}/${meta.target}"
                }
            },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    
    withName: 'TRUVARI_REFINE' {
        container = { params.truvari_container }
        ext.args = { "--align ${params.truvari_refine_align}" }
        ext.prefix = { "${meta.technology}-${meta.tool}-${meta.target}" }
        cpus = 8
        // A refine takes seconds to about two minutes. One ONT refine hung for 16 h
        // in "Harmonizing variants" on 2026-09-29; a short limit turns a hang into
        // a failure that the retry below handles.
        time = '2.h'
        // The module handles "no regions to be refined" itself, so a non-zero
        // exit reaching here is a genuine error. Retry once for transient
        // trouble, then ignore rather than discarding a completed benchmark -
        // refinement is layered on top of results that are already written, and
        // run_both_clean.sh counts the refine outputs so a gap stays visible.
        errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }
        maxRetries = 1
        publishDir = [
            path: { "${params.outdir}/real_intervals/${meta.technology}/truvari/${meta.tool}/${meta.target}" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // withName: 'BGZIP_TABIX.*' {
    //     container = 'community.wave.seqera.io/library/htslib:1.21--ff8e28a189fbecaa'
    // }

    withName: 'BGZIP_TABIX_CUTESV_PACBIO' {
        ext.args2 = '-p vcf'
        publishDir = [
            path: { "${params.outdir}/sv_calls/PacBio/CuteSV" },
            mode: 'copy',
            pattern: '*.vcf.gz*',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    
    withName: 'BGZIP_TABIX_CUTESV_ONT' {
        ext.args2 = '-p vcf'
        publishDir = [
            path: { "${params.outdir}/sv_calls/ONT/CuteSV" },
            mode: 'copy',
            pattern: '*.vcf.gz*',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    
    withName: 'BGZIP_TABIX_PBSV' {
        ext.args2 = '-p vcf'
        publishDir = [
            path: { "${params.outdir}/sv_calls/PacBio/PBSV" },
            mode: 'copy',
            pattern: '*.vcf.gz*',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    
    // withName: 'BEDTOOLS_.*' {
    //     container = 'quay.io/biocontainers/bedtools:2.31.1--hf5e1c6e_0'
    // }
    
    // withName: 'GUNZIP' {
    //     container = 'quay.io/biocontainers/gzip:1.12'
    // }
    
    withName: 'SIMULATE_TARGETS' {
        container = { params.analysis_container }
        publishDir = [
            [
                path: { "${params.outdir}/simulations" },
                mode: 'copy',
                pattern: 'simulated_targets',
                saveAs: { 'target_regions' }
            ]
        ]
    }
    
    withName: 'GATHER_STATISTICS' {
        container = { params.analysis_container }
        publishDir = [
            [
                path: { "${params.outdir}/statistics" },
                mode: 'copy'
            ]
        ]
    }

    withName: 'EXCLUDE_HOMREF_CALLS' {
        container = { params.analysis_container }
        publishDir = [
            path: { "${params.outdir}/benchmarked_calls/${meta.technology}/${meta.tool}" },
            mode: 'copy'
        ]
    }

    // Post-hoc analyses: the steps that use Truvari's own code run in its image,
    // the rest in the analysis image; all publish under posthoc/. The selectors use
    // the fully qualified name, because Nextflow ranks a match on it above a match
    // on the simple name, and a later, more specific rule must win.
    withName: 'POSTHOC_ANALYSES:POSTHOC_.*' {
        container = { params.analysis_container }
        publishDir = [
            path: { "${params.outdir}/posthoc" },
            mode: 'copy'
        ]
    }
    withName: 'POSTHOC_ANALYSES:POSTHOC_(SVTYPE_ACCOUNTING|STRATIFY|SVANALYZER_PREFILTER)' {
        container = { params.truvari_container }
    }
    withName: 'POSTHOC_ANALYSES:POSTHOC_SVANALYZER_PREFILTER' {
        publishDir = [enabled: false]
    }
    // The bioconda build 0.36--pl5262hdfd78af_1 ships the edlib-aligner executable
    // that `svanalyzer benchmark` calls; the later _2 build does not.
    withName: 'POSTHOC_ANALYSES:POSTHOC_SVANALYZER' {
        container = {
            params.svanalyzer_container ?: (workflow.containerEngine in ['singularity', 'apptainer']
                ? 'https://depot.galaxyproject.org/singularity/svanalyzer:0.36--pl5262hdfd78af_1'
                : 'quay.io/biocontainers/svanalyzer:0.36--pl5262hdfd78af_1')
        }
        memory = 16.GB
        time = 12.h
        publishDir = [
            path: { "${params.outdir}/posthoc/svanalyzer/runs" },
            mode: 'copy',
            pattern: '*.{report,log}'
        ]
    }
    withName: 'POSTHOC_ANALYSES:POSTHOC_SVANALYZER_ELIGIBILITY' {
        publishDir = [
            path: { "${params.outdir}/posthoc/svanalyzer" },
            mode: 'copy'
        ]
    }
    withName: 'POSTHOC_ANALYSES:POSTHOC_MEMBERSHIP' {
        publishDir = [
            path: { "${params.outdir}/posthoc/membership" },
            mode: 'copy'
        ]
    }
    withName: 'POSTHOC_ANALYSES:POSTHOC_MANUSCRIPT_VALUES' {
        publishDir = [
            path: { "${params.outdir}/posthoc/manuscript" },
            mode: 'copy'
        ]
    }
    withName: 'POSTHOC_ANALYSES:POSTHOC_DECOMPOSITION' {
        publishDir = [
            path: { "${params.outdir}/posthoc/decomposition" },
            mode: 'copy'
        ]
    }
    withName: 'POSTHOC_ANALYSES:POSTHOC_STRATIFY' {
        publishDir = [
            path: { "${params.outdir}/posthoc/stratified" },
            mode: 'copy'
        ]
    }
    withName: 'POSTHOC_ANALYSES:POSTHOC_SENSITIVITY' {
        publishDir = [
            path: { "${params.outdir}/posthoc/sensitivity" },
            mode: 'copy'
        ]
    }
    // Holds one chromosome's GC and base prefix sums at a time; the GRCh37 run
    // peaked at 11.3 GB and swapped for hours under the 4 GB default.
    withName: 'POSTHOC_ANALYSES:POSTHOC_FIDELITY' {
        memory = 16.GB
    }

    withName: 'PAD_TARGET_BED' {
        container = { params.analysis_container }
        publishDir = [
            path: { "${params.outdir}/sensitivity/target_beds" },
            mode: 'copy'
        ]
    }

    withName: 'TARGET_TRANSITION_AUDIT' {
        container = { params.analysis_container }
        publishDir = [
            path: { "${params.outdir}/target_transition_evidence/per_pipeline" },
            mode: 'copy',
            pattern: 'evidence/*'
        ]
    }

    withName: 'MERGE_TARGET_TRANSITION_EVIDENCE' {
        container = { params.analysis_container }
        publishDir = [
            path: { "${params.outdir}/target_transition_evidence/tables" },
            mode: 'copy'
        ]
    }

    withName: 'PLOT_TARGET_TRANSITION_EVIDENCE' {
        container = { params.analysis_container }
        publishDir = [
            path: { "${params.outdir}/target_transition_evidence/figures" },
            mode: 'copy',
            pattern: 'figures/*'
        ]
    }

    withName: 'SIMULATION_TRANSITION_AUDIT' {
        container = { params.analysis_container }
    }

    withName: 'MERGE_SIMULATION_TRANSITION_EVIDENCE' {
        container = { params.analysis_container }
        publishDir = [
            path: { "${params.outdir}/target_transition_evidence/simulations/tables" },
            mode: 'copy'
        ]
    }

    // withName: 'DOWNLOAD_.*' {
    //     container = 'quay.io/biocontainers/samtools:1.19.2--h50ea8bc_1'
    // }
    
    // withName: 'CREATE_.*' {
    //     container = 'rocker/tidyverse:4.4.1'
    // }
}
