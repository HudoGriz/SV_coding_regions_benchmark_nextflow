/*
========================================================================================
    Study profile: every analysis reported in the manuscript
========================================================================================
    500 simulated interval sets, statistics and plots, target-transition evidence,
    the sensitivity benchmarks and the post-hoc analyses. Delly and the removal of
    calls genotyped 0/0 are on by default. Combine with a container profile:

      nextflow run . -params-file params_GRCh38.yaml -profile singularity,study
----------------------------------------------------------------------------------------
*/

params {
    simulate_targets             = true
    num_simulations              = 500
    gather_statistics            = true
    generate_transition_evidence = true
    sensitivity_benchmarks       = true
    posthoc_analyses             = true
}
