/*
========================================================================================
    Nextflow Configuration File
========================================================================================
*/

params {
    // Output
    run_name = 'benchmarking_run'
    outdir = "${launchDir}/${params.run_name}"
    
    // Required inputs
    fasta = null
    benchmark_vcf = null
    
    // Optional BAM inputs
    illumina_wes_bam = null
    illumina_wgs_bam = null
    pacbio_bam = null
    ont_bam = null
    
    // Optional target regions
    high_confidence_targets = null
    gene_panel_targets = null
    wes_utr_targets = null
    wes_sequencing_targets = null  // BED file for WES target regions (used by Manta --callRegions)
    tandem_repeats = null
    
    // Pipeline control
    skip_benchmarking = false
    skip_pbsv = false
    
    // Truvari parameters
    truvari_refdist = 500
    truvari_pctsize = 0.7
    truvari_pctovl = 0
    truvari_pctseq = 0
    
    // WES-specific Truvari parameters (used for Illumina WES data)
    truvari_wes_refdist = 500
    truvari_wes_pctsize = 0.7
    truvari_wes_pctovl = 0
    truvari_wes_pctseq = 0

    // Truvari 5.4.0 with --bench-overlaps. Built from CISLD/truvari
    // (branch deploy/bench-overlaps-5.4.0) via Singularity.bench-overlaps.
    // Published, signed and immutable; Nextflow pulls it on first use.
    // This is the numeric form of the option, which conf/modules.config sets
    // as `--bench-overlaps 1`. It reproduces the published boolean-form runs
    // exactly: 297 metrics over 33 benchmarks, 0 mismatches.
    truvari_container = 'library://blazv/benchmark-sv/truvari_modded:5.4.0-overlaps-numeric'

    // Breakend handling. The GIAB truth sets contain only DEL and INS, so any
    // BND a caller emits can never match and is counted as a false positive.
    // Callers differ enormously in how much they emit (Manta 39.8% of PASS
    // calls, long-read callers 0.2-2.2%), so this is scored both ways:
    //   nobnd   - BNDs excluded via Truvari's documented --bnddist -1
    //   withbnd - BNDs retained (Truvari's default), as a sensitivity analysis
    // Results for the primary mode publish to the usual paths; the other mode
    // publishes under bnd_sensitivity/ and is excluded from the main tables.
    // Harmonize variant representation with `truvari refine` before scoring.
    // Runs on the real targets in the primary breakend mode only; the 500-set
    // empirical null is left unrefined because it would multiply runtime by the
    // number of simulations for a distribution whose shape the harmonization is
    // not expected to move.
    truvari_refine = true
    // wfa and mafft are both deterministic; poa, which is Truvari's default,
    // is documented as non-deterministic and so is unsuitable for a benchmark.
    // wfa is ~2.5x faster than mafft and gave equivalent results here.
    truvari_refine_align = 'wfa'

    bnd_modes = 'nobnd,withbnd'
    // The 500-set empirical null is the expensive part, so by default only the
    // primary mode runs there. Set to the same value as bnd_modes to score the
    // null both ways as well.
    bnd_modes_simulated = 'nobnd'
    primary_bnd_mode = 'nobnd'

    // Simulation (optional)
    simulate_targets = false
    num_simulations = 100
    gather_statistics = false
    generate_transition_evidence = false
    transition_hci_target = 'high_confidence'
    transition_target = 'wes_utr'
    transition_target_label = 'EX+UTR'
    transition_include_wes = false
    reference_assembly = null
    // Published, signed and immutable; Nextflow pulls it on first use. The old
    // default was a gitignored relative path, so a fresh clone had no image at
    // all. Python 3.11.15 with R 4.4.1; see containers/Singularity.python-r-analysis.
    analysis_container = 'library://blazv/benchmark-sv/python-r-analysis:py3.11-r4.4.1'
    
    // Resources
    max_cpus = 24
    max_memory = '128.GB'
    max_time = '48.h'
    
    help = false
}

// Load process selectors after parameter defaults so container closures resolve
// without undefined-parameter warnings during configuration parsing.
includeConfig 'conf/modules.config'

process {
    // Nextflow caps every request at these ceilings, which replaces the former
    // check_max() helper; config files may no longer define functions. The closure
    // keeps evaluation lazy, so a profile or a --max_cpus on the command line still
    // moves the ceiling. A plain map would be resolved before those are applied.
    resourceLimits = { [
        cpus: params.max_cpus as int,
        memory: params.max_memory as nextflow.util.MemoryUnit,
        time: params.max_time as nextflow.util.Duration
    ] }

    cpus = 1
    memory = 4.GB
    time = 4.h
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries = 1
    maxErrors = '-1'

    withLabel: 'process_low' {
        cpus = 2
        memory = 8.GB
        time = 4.h
    }

    withLabel: 'process_medium' {
        cpus = 8
        memory = 32.GB
        time = 8.h
    }

    withLabel: 'process_high' {
        cpus = { params.max_cpus }
        memory = 64.GB
        time = 12.h
    }
}

profiles {
    test { includeConfig 'conf/test.config' }
    test_nfcore { includeConfig 'conf/test_nfcore.config' }
    
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        includeConfig 'conf/modules.config'
        process {
            withName: 'SIMULATE_TARGETS|GATHER_STATISTICS|CREATE_.*' {
                container = { params.analysis_container }
            }
        }
    }
    
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        includeConfig 'conf/modules.config'
    }
}

manifest {
    name = 'sv-calling-pipeline'
    description = 'SV calling and benchmarking pipeline'
    mainScript = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version = '1.0.0'
}

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'


timeline.enabled = true
timeline.file = "${params.outdir}/pipeline_info/timeline.html"
report.enabled = true
report.file = "${params.outdir}/pipeline_info/report.html"
trace.enabled = true
trace.file = "${params.outdir}/pipeline_info/trace.txt"
